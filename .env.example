# 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# Gemini API Key (可选，也可在前端配置)
GEMINI_API_KEY=your_api_key_here

# Gemini API Base URL (图片生成端点)
GEMINI_BASE_URL=https://vip.yyds168.net

# Flow2API Base URL (视频生成端点)
FLOW2API_BASE_URL=https://vip.yyds168.net/v1/chat/completions

# Optional server-side API key aliases
FLOW2API_API_KEY=

# Request timeout in milliseconds
FLOW2API_TIMEOUT_MS=300000

# Retry count for transient upstream/proxy failures
PROXY_MAX_RETRIES=2

# Allowed hosts for media proxying (comma-separated)
PROXY_ALLOWED_HOSTS=vip.yyds168.net,api.yyds168.net,storage.googleapis.com

# 服务端口 (Zeabur 会自动设置)
PORT=3000

# 运行环境
NODE_ENV=production
